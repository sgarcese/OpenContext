# Copy to secrets.staging.tfvars or secrets.prod.tfvars (both gitignored).
# ./scripts/deploy.sh --environment <staging|prod> loads secrets.<env>.tfvars
# automatically so staging and prod never share a client or IdP host.

oauth_idp_host      = "strivacity-test.boston.gov"
oauth_client_id     = "your-strivacity-client-id"
oauth_client_secret = "your-strivacity-client-secret"
